# Supabase credentials (get these from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KITCHEN_URL=http://localhost:3000/kitchen
NEXT_PUBLIC_CUSTOMER_MENU_URL=http://localhost:3000/menu

# n8n Integration
N8N_SHARED_SECRET=your-shared-secret-key
N8N_READY_WEBHOOK_URL=https://n8n.your-domain.com/webhook/order-ready

